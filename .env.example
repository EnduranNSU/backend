# Picks where chat completions are sent: yandex | openai | ollama
LLM_PROVIDER=yandex

# --- Yandex ---
YANDEX_FOLDER_ID=
YANDEX_API_KEY=
LLM_CHAT_MODEL=gpt://<folder_id>/qwen3-235b-a22b-fp8/latest

# --- OpenAI / compatible ---
# OPENAI_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_CHAT_MODEL=gpt-4o-mini

# --- Ollama (local, runs in compose if you uncomment the service) ---
# LLM_BASE_URL=http://ollama:11434/v1
# LLM_CHAT_MODEL=qwen2.5:3b
